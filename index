function loadScanFile(key,file){if(!Object.prototype.hasOwnProperty.call(scanFiles,key)||!file)return;if(!/^image\/(png|jpeg|webp)$/.test(file.type)){scanStatus('PNG / JPG / WEBP');return;}if(file.size>12*1024*1024){scanStatus('Max 12 MB');return;}if(scanURLs[key])URL.revokeObjectURL(scanURLs[key]);scanFiles[key]=file;scanURLs[key]=URL.createObjectURL(file);scanRaw[key]='';const resetFields=key==='stat'?['level','str','dex','int','luk']:key==='weapon'?['weaponAttack','weaponMagic']:['gloveAttack','gloveMagic'];for(const field of resetFields)scanValues[field]='';activeScanSlot=['stat','weapon','gloves'].find(k=>!scanFiles[k])||key;render();scanStatus(t('pasteImported')+' ('+key+'). '+(Object.values(scanFiles).every(Boolean)?t('scanReady'):t('pasteNext')+' '+activeScanSlot));}
