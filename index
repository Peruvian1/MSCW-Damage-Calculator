async function startOCR(){if(scanBusy||!Object.values(scanFiles).every(Boolean)){scanStatus(t('scanMissing'));return;}scanBusy=true;try{scanStatus(t('scanOCRWait')+'…');const lib=await loadTesseract();for(const k of ['stat','weapon','gloves']){scanStatus(t('scanOCRWait')+' '+k+'…');const output=await lib.recognize(scanFiles[k],'eng');const text=output?.data?.text||'';scanRaw[k]=text;const found=k==='stat'?extractStat(text):extractGear(text,k);if(found.secondaryReq!==undefined){found.secondaryReq=String(Math.max(num(scanValues.secondaryReq,0),num(found.secondaryReq,0)));}Object.assign(scanValues,found);updateScanClass();const textBox=$('scanRaw-'+k);if(textBox)textBox.value=text;for(const [field,value] of Object.entries(scanValues)){const el=document.querySelector(`[data-scan-field="${field}"]`);if(el)el.value=value;}}
scanStatus(t('scanNeedReview'));}catch(err){console.warn('OCR error:',err);scanStatus(t('scanOCRFailed'));}finally{scanBusy=false;}}
