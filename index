function wrapBuilderPanel(el,key,label,isOpen){const title=el.querySelector(':scope > h2');if(!title)return;const details=document.createElement('details');details.className='card config-panel';details.dataset.uiPanel=key;details.open=!!isOpen;const summary=document.createElement('summary');summary.innerHTML=`<span>${title.innerHTML}</span><span class="config-summary-right">${safe(label)} <b>⌄</b></span>`;details.appendChild(summary);const body=document.createElement('div');body.className='config-body';[...el.children].filter(x=>x!==title).forEach(x=>body.appendChild(x));details.appendChild(body);el.replaceWith(details);return details;}
function enhanceBuilder(){const left=document.querySelector('.leftcol');if(!left)return;const cards=[...left.children].filter(el=>el.matches('section.card'));if(cards.length<5)return;const [profile,equip,advanced,buffs,skill]=cards;left.insertBefore(skill,equip);const translations=[['skill',skill,u3('skill')],['equip',equip,u3('gear')],['buffs',buffs,u3('buffs')],['advanced',advanced,u3('advanced')]];for(const [key,el,label] of translations)wrapBuilderPanel(el,key,label,state.uiPanels[key]!==false);const headline=$('root').querySelector('.headline');if(headline){headline.querySelector('h1').textContent=u3('buildTitle');const para=headline.querySelector('p');if(para)para.textContent=u3('buildSub');}const right=document.querySelector('.rightcol');const targetCard=right?.querySelector(':scope > section.card');if(targetCard){targetCard.classList.add('simplified-target');const fields=[...targetCard.children];const search=targetCard.querySelector('#monsterSearch')?.parentElement;const wrap=document.createElement('details');wrap.className='monster-extra';const summary=document.createElement('summary');summary.textContent=u3('monsterDetails')+' ⌄';wrap.appendChild(summary);const body=document.createElement('div');body.className='monster-extra-body';fields.forEach(el=>{if(el!==search&&el.tagName!=='H2')body.appendChild(el)});wrap.appendChild(body);targetCard.appendChild(wrap);} }

