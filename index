function renderFinder(){const p=prof();return `<div class="v3-finder"><div class="page-lead"><div class="section-eyebrow">ARCADE / MOB INTELLIGENCE</div><div class="lead-row"><div><h1>${u3('findTitle')}</h1><p>${u3('findDesc')}</p></div><button class="button" data-tab="sim">⚔ ${u3('change')}</button></div></div><section class="dash-panel finder-tools"><div class="finder-toprow"><div class="field"><label for="finderQuery">${u3('search')}</label><input id="finderQuery" type="search" placeholder="${u3('search')}" value="${safe(state.finderQuery||'')}"></div><div class="finder-chips">${[['all','all'],['1','one'],['2','two'],['3','three']].map(([id,label])=>`<button class="cast-chip ${(state.finderCast||'all')===id?'active':''}" data-findercast="${id}">${u3(label)}</button>`).join('')}</div></div><div class="finder-options"><div>${slider('recThreshold','recMin',50,100,5,'mint')}</div><div>${slider('recMinLevel','recLevelMin',1,80,1,'mint')}</div><div class="finder-checks">${checkbox('critOn','useCrit')}${checkbox('accuracyOn','useAccuracy')}</div></div><div class="subtle-hint">${u3('resultCount')}</div></section><div id="finderResults">${renderRecommendations(p)}</div><section class="dash-panel guide-panel"><div class="section-eyebrow">${u3('help')}</div><p>${u3('helpText')}</p></section></div>`;}
