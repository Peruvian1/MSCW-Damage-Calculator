function loadTesseract(){return new Promise((resolve,reject)=>{if(window.Tesseract){resolve(window.Tesseract);return;}const script=document.createElement('script');script.src='https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js';script.crossOrigin='anonymous';script.onload=()=>window.Tesseract?resolve(window.Tesseract):reject(new Error('Missing Tesseract'));script.onerror=()=>reject(new Error('OCR CDN unreachable'));document.head.appendChild(script);});}
function numFromOCR(v){let z=String(v).replace(/[Oо]/g,'0').replace(/[Il|]/g,'1').replace(/[, ]/g,'');const n=z.match(/[0-9]{1,5}/);return n?Number(n[0]):null;}
function extractStat(text){const t=text.replace(/[：]/g,':').replace(/[|]/g,'I');const fields={level:/\b(?:LV\.?|LEVEL)\s*[:.]?\s*(\d{1,3})\b/i,str:/\bSTR\s*[:.]?\s*(\d{1,4})/i,dex:/\bDEX\s*[:.]?\s*(\d{1,4})/i,int:/\bINT\s*[:.]?\s*(\d{1,4})/i,luk:/\bLUK\s*[:.]?\s*(\d{1,4})/i};const out={};for(const [k,pat] of Object.entries(fields)){const m=t.match(pat);if(m)out[k]=String(+m[1]);}return out;}
function extractGear(text,slot){const lines=text.replace(/：/g,':').split(/\r?\n/);const out={};const w=slot==='weapon'?'weaponAttack':'gloveAttack',m=slot==='weapon'?'weaponMagic':'gloveMagic';for(const line of lines){const x=line.trim().replace(/[Oо](?=\d)/g,'0');let match;if(/\b(?:W\.?\s*(?:ATK|ATT)|WEAPON\s*(?:ATT|ATK|ATTACK)|WEAPON\s*ATT\.|WA)\b/i.test(x)&&!/(?:REQUIR|SCROLL|POTENTIAL|BONUS\s*STAT)/i.test(x)){match=x.match(/(?:W\.?\s*(?:ATK|ATT)|WEAPON\s*(?:ATT|ATK|ATTACK)|WA)\s*[:.]*\s*\+?\s*(\d{1,4})\b/i);if(match)out[w]=match[1];}if(/\b(?:M\.?\s*(?:ATK|ATT)|MAGIC\s*(?:ATT|ATK|ATTACK)|MA)\b/i.test(x)&&!/(?:REQUIR|SCROLL|POTENTIAL|BONUS\s*STAT)/i.test(x)){match=x.match(/(?:M\.?\s*(?:ATK|ATT)|MAGIC\s*(?:ATT|ATK|ATTACK)|MA)\s*[:.]*\s*\+?\s*(\d{1,4})\b/i);if(match)out[m]=match[1];}}
// Optional secondary requirement from the weapon/gloves; other gear may require more.
const second=secondaryStat(prof());const req=new RegExp('(?:REQ(?:UIRED)?\\.?|NEEDED|NEEDS)\\s*\\.?\\s*'+second+'\\s*[:.]*\\s*(\\d{1,4})','i');const found=text.match(req);if(found)out.secondaryReq=found[1];return out;}
