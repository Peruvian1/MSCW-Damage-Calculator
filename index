function changeSkill(id){const p=prof();if(!SKILLS[id])return;p.skill=id;p.skillLevel=SKILLS[id].max;p.skillPower=SKILLS[id].power;const sm=spellMasteryAtLevel(id,p.skillLevel);if(sm!==null)p.mastery=sm;render();}
function setMobName(name){const m=findMob(name);if(!m)return false;prof().targetName=m.name;prof().targetOverride=null;prof().elemOverride='auto';state.tab='sim';render();return true;}
function saveMob(){const m=target();const name=prompt(t('monster'),m.name);if(!name?.trim())return;const record=normalizeMob({...m,name:name.trim(),custom:true,source:'Local user entry'});const ix=state.customMobs.findIndex(x=>x.name.toLowerCase()===record.name.toLowerCase());if(ix>=0)state.customMobs[ix]=record;else state.customMobs.push(record);prof().targetName=record.name;prof().targetOverride=null;render();}
function newMob(){prof().targetName='Custom monster';prof().targetOverride=normalizeMob({name:'Custom monster',level:30,hp:1000,mdef:0,pdef:0,eva:0,exp:0,undead:false,custom:true,source:'Local user entry'});state.tab='sim';render();}
function resetMob(){prof().targetOverride=null;render();}
function saveAs(name,content,mime){const url=URL.createObjectURL(new Blob([content],{type:mime}));const a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);}
function csv(rows){return '\ufeff'+rows.map(row=>row.map(x=>{const s=String(x??'');return /[",\r\n]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s;}).join(',')).join('\r\n');}
function exportMobs(){saveAs('arcane_lab_monsters_v2.csv',csv([['name','level','hp','mdef','pdef','eva','exp','undead','ice','fire','lightning','holy','poison','source'],...allMobs().map(x=>[x.name,x.level,x.hp,x.mdef,x.pdef,x.eva,x.exp,x.undead?1:0,...['ice','fire','lightning','holy','poison'].map(k=>x.relations[k]),x.source])]),'text/csv;charset=utf-8');}
function exportCompare(){const p=prof();saveAs('arcane_lab_comparison_'+p.job+'.csv',csv([['monster','level','hp','mdef','pdef','exp','skill','min','avg','max','chance_1','chance_2','chance_3','chance_4','chance_5','chance_6'],...allMobs().map(m=>{const r=compute(p,m),c=probabilities(p,m,r,900);return [m.name,m.level,m.hp,m.mdef,m.pdef,m.exp,p.skill,(r.low*r.hits).toFixed(2),r.avg.toFixed(2),(r.high*r.hits).toFixed(2),...c.map(x=>(x*100).toFixed(2))];})]),'text/csv;charset=utf-8');}
function csvParse(text){let list=[],row=[],field='',quoted=false;for(let i=0;i<text.length;i++){const ch=text[i];if(quoted){if(ch==='"'&&text[i+1]==='"'){field+='"';i++;}else if(ch==='"')quoted=false;else field+=ch;}else if(ch==='"')quoted=true;else if(ch===','){row.push(field);field='';}else if(ch==='\n'){row.push(field.replace(/\r$/,''));list.push(row);field='';row=[];}else field+=ch;}row.push(field.replace(/\r$/,''));if(row.some(x=>x!==''))list.push(row);return list;}
function importMobs(text){const rows=csvParse(text.replace(/^\ufeff/,'')),head=rows[0].map(x=>x.toLowerCase().trim());for(const k of ['name','level','hp','mdef'])if(!head.includes(k))throw Error('Missing '+k);let n=0;for(const row of rows.slice(1)){const d=Object.fromEntries(head.map((k,i)=>[k,row[i]??'']));if(!d.name||num(d.hp)<=0)continue;let m=normalizeMob({name:d.name,level:d.level,hp:d.hp,mdef:d.mdef,pdef:d.pdef,eva:d.eva,exp:d.exp,undead:['1','true','yes','si'].includes(String(d.undead).toLowerCase()),relations:Object.fromEntries(['ice','fire','lightning','holy','poison'].map(k=>[k,d[k]===''||d[k]===undefined?1:clamp(num(d[k],1),0,2)])),source:d.source||'CSV import',custom:true});const ix=state.customMobs.findIndex(x=>x.name.toLowerCase()===m.name.toLowerCase());if(ix>=0)state.customMobs[ix]=m;else state.customMobs.push(m);n++;}return n;}
function action(a){const p=prof();if(a==='openScanner'){state.tab='scan';render();window.scrollTo(0,0);}else if(a==='anchor'){reanchor(p);render();}else if(a==='readScreens'){startOCR();}else if(a==='applyScreens'){applyScanned();}else if(a==='clearScreens'){clearScanner();}else if(a==='save'){persist();alert(t('saveSuccess'));}else if(a==='addProfile'){const name=prompt(t('profileName'),state.lang==='en'?'New character':'Nuevo personaje');if(!name?.trim())return;const id='p'+Date.now();state.profiles[id]=baseProfile(p.job,name.trim());state.current=id;render();}else if(a==='rename'){const name=prompt(t('profileName'),p.name);if(name?.trim()){p.name=name.trim();render();}}else if(a==='delete'){if(Object.keys(state.profiles).length<=1)return;if(!confirm(t('removeConfirm')))return;delete state.profiles[state.current];state.current=Object.keys(state.profiles)[0];render();}else if(a==='saveMob')saveMob();else if(a==='newMob')newMob();else if(a==='resetMob')resetMob();else if(a==='exportMobs')exportMobs();else if(a==='importMobs')$('mobFile').click();else if(a==='exportCompare')exportCompare();}
// All controls use delegated events so sliders update output without losing drag position.
document.addEventListener('input',e=>{const el=e.target,p=prof();if(el.id==='finderQuery'){state.finderQuery=el.value;refreshFinderResults();persist();return;}if(el.dataset.scanField){scanValues[el.dataset.scanField]=el.value.trim();return;}if(el.dataset.key){const k=el.dataset.key;let value=num(el.value);if(k==='level'||k==='medLevel'||k==='skillLevel'||k==='mastery'||k==='ironIndex'||k==='healUndead'||k==='healAllies')value=Math.round(value);if(k==='level')projectLevel(p,value);else p[k]=value;if(k==='starPower')p.scanNeedsStar=false;if(['int','luk','dex','str'].includes(k))reanchor(p);if(k==='secondaryReq'&&p.autoLevelOn)projectLevel(p,p.level);const peer=$( (el.type==='range'?'number-':'range-')+k );if(peer){if(peer.type==='range'&&value>num(peer.max))peer.max=String(value);peer.value=String(value);}if(k==='skillLevel'){const preset=powerByLevel(p.skill,p.skillLevel);p.skillPower=preset.power;const sm=spellMasteryAtLevel(p.skill,p.skillLevel);if(sm!==null)p.mastery=sm;const powerNumber=$('number-skillPower'),powerSlider=$('range-skillPower');if(powerNumber)powerNumber.value=String(p.skillPower);if(powerSlider)powerSlider.value=String(p.skillPower);const masteryNumber=$('number-mastery'),masterySlider=$('range-mastery');if(sm!==null){if(masteryNumber)masteryNumber.value=String(sm);if(masterySlider)masterySlider.value=String(sm);}}if(k==='level'&&p.autoLevelOn){for(const st of STATS[p.job]){const sn=$('number-'+st),sr=$('range-'+st);if(sn)sn.value=p[st];if(sr){if(p[st]>num(sr.max))sr.max=p[st];sr.value=p[st];}}}const md=$('medDerived');if(md)md.textContent='+'+meditationBonus(p);queueUpdate();}else if(el.dataset.target){const m=target();const key=el.dataset.target;m[key]=el.type==='checkbox'?el.checked:positive(el.value);m.custom=true;p.targetOverride=m;queueUpdate();}else if(el.id==='bestFilter'||el.id==='bestMin'){state.bestFilter=$('bestFilter').value;state.bestMin=positive($('bestMin').value);$('bestBody').innerHTML=mobRows(allMobs().filter(m=>m.name.toLowerCase().includes(state.bestFilter.toLowerCase())&&m.level>=state.bestMin));persist();}else if(el.id==='compareFilter'||el.id==='compareMin'){state.compareFilter=$('compareFilter').value;state.compareMin=positive($('compareMin').value);const p=prof(),list=allMobs().filter(m=>m.name.toLowerCase().includes(state.compareFilter.toLowerCase())&&m.level>=state.compareMin).map(m=>{const r=compute(p,m);return {m,r,chance:probabilities(p,m,r,450)[2]}}).sort((a,b)=>(b.m.exp/Math.max(1,b.r.avg)-a.m.exp/Math.max(1,a.r.avg)));$('compareBody').innerHTML=compareRows(list);persist();}});
document.addEventListener('change',e=>{const el=e.target,p=prof();if(el.dataset.scanJob){if(JOBS[el.value]){scanCandidateJob=el.value;scanJobManuallyChosen=true;scanClassReason='Manually selected';updateScanClass();}return;}if(el.dataset.scanFile){loadScanFile(el.dataset.scanFile,el.files?.[0]);return;}if(el.dataset.scanField){scanValues[el.dataset.scanField]=el.value.trim();return;}if(el.dataset.check){p[el.dataset.check]=el.checked;if(el.dataset.check==='autoLevelOn'&&el.checked)reanchor(p);queueUpdate();}else if(el.dataset.select){const k=el.dataset.select;if(k==='skill'){changeSkill(el.value);return;}p[k]=el.value;queueUpdate();}else if(el.id==='monsterSearch'){if(!setMobName(el.value))alert(state.lang==='en'?'Monster not found; create a custom monster.':'Monstruo no encontrado; crea uno personalizado.');}else if(el.id==='profileSelect'){state.current=el.value;render();}});
document.addEventListener('click',e=>{const cast=e.target.closest('[data-findercast]');if(cast){state.finderCast=cast.dataset.findercast;render();return;}const ht=e.target.closest('[data-home-toggle]');if(ht){const k=ht.dataset.homeToggle;if(k==='critOn'||k==='accuracyOn'){prof()[k]=!prof()[k];render();}return;}const sr=e.target.closest('[data-rec-sort]');if(sr){const key=sr.dataset.recSort;state.recSortDir=state.recSortKey===key?(state.recSortDir==='asc'?'desc':'asc'):(key==='casts'?'asc':'desc');state.recSortKey=key;if(state.tab==='sim')renderResults();else if(state.tab==='finder')refreshFinderResults();persist();return;}const p=e.target.closest('[data-paste-slot]');if(p){pasteFromClipboard(p.dataset.pasteSlot);return;}const slot=e.target.closest('[data-scan-slot]');if(slot)selectScanSlot(slot.dataset.scanSlot);const x=e.target.closest('[data-tab],[data-lang],[data-job],[data-action],[data-usemob],[data-skillpick]');if(!x)return;if(x.dataset.lang){state.lang=x.dataset.lang;render();}else if(x.dataset.tab){state.tab=x.dataset.tab;render();window.scrollTo(0,0);}else if(x.dataset.job){const old=prof();if(old.job===x.dataset.job)return;const auto=old.name==='Ice/Lightning Lv68'||old.name===JOBS[old.job].name+' Lv'+old.level;const nextName=auto?JOBS[x.dataset.job].name+' Lv'+(JOBS[x.dataset.job].type==='magic'?68:60):old.name;state.profiles[state.current]=baseProfile(x.dataset.job,nextName);state.profiles[state.current].targetName=old.targetName;render();}else if(x.dataset.action){action(x.dataset.action);}else if(x.dataset.usemob){setMobName(x.dataset.usemob);window.scrollTo(0,0);}else if(x.dataset.skillpick){changeSkill(x.dataset.skillpick);}});
document.addEventListener('toggle',e=>{const d=e.target;if(d.matches?.('details[data-ui-panel]')){state.uiPanels[d.dataset.uiPanel]=d.open;persist();}},true);
$('exportBackup').onclick=()=>saveAs('arcane_lab_backup_v2.json',JSON.stringify({format:'arcane-lab-v2',...state},null,2),'application/json');
$('importBackup').onclick=()=>$('backupFile').click();$('exportCompare').onclick=exportCompare;
function migrateBackup(data){
 // Old Arcane Lab 1.x stored magic-only fields with different names. Preserve users' saved characters.
 if(data.format!=='arcane-lab-v1'&&!Object.values(data.profiles||{}).some(p=>'wand' in p&&!('wandBase' in p)))return data;
 const profiles={};for(const [id,old] of Object.entries(data.profiles||{})){
  const job=JOBS[old.job]?old.job:'il';const p=baseProfile(job,old.name||id);
  Object.assign(p,{level:num(old.level,p.level),int:num(old.int,p.int),luk:num(old.luk,p.luk),wandBase:num(old.wand,69),wandScroll:num(old.scroll,16),glovesM:num(old.gloves,6),otherM:num(old.other,0),medOn:!!old.medOn,med:num(old.medValue,25),medLevel:num(old.medValue,25)>=25?20:Math.max(0,num(old.medValue,5)-4),potionOn:!!old.potOn,potionM:num(old.potValue,10),otherBuffM:num(old.extraBuff,0),skill:SKILLS[old.skill]?old.skill:p.skill,skillLevel:num(old.skillLevel,30),skillPower:num(old.skillPower,170),mastery:num(old.mastery,10),manualBonus:num(old.manualBonus,0),healUndead:num(old.healUndead,1),healAllies:num(old.healAllies,0),elemOverride:old.elemRel||'auto',targetBonus:num(old.extraTargetBonus,0),accuracyOn:!!old.accuracyOn,critOn:!!old.criticalOn,critRate:num(old.critChance,5),critBonus:num(old.critBonus,20),targetName:old.monster||'Red Drake'});
  profiles[id]=p;
 }
 return {format:'arcane-lab-v2',profiles,current:data.current,customMobs:data.customMobs||[],selectedMob:data.selectedMob,lang:'en',tab:'sim'};
}
$('backupFile').onchange=async e=>{const file=e.target.files?.[0];if(!file)return;try{const data=migrateBackup(JSON.parse(await file.text()));if(!data.profiles||!Object.keys(data.profiles).length)throw Error('Invalid profile data');if(!confirm(state.lang==='en'?'Replace current local profiles with this backup?':'¿Reemplazar perfiles locales por este respaldo?'))return;state={...defaults,...data,lang:TXT[data.lang]?data.lang:'en',tab:'home',arcane3UI:true};Object.values(state.profiles).forEach(normalizedProfile);
// Migrate the UI without altering existing profile data or the localStorage key.
if(!state.arcane3UI){state.tab='home';state.arcane3UI=true;}
if(!['home','sim','finder','scan','mobs','compare','docs'].includes(state.tab))state.tab='home';
state.finderCast=state.finderCast||'all';state.finderQuery=state.finderQuery||'';state.uiPanels=state.uiPanels||{skill:true,equip:true,buffs:false,advanced:false};if(!state.profiles[state.current])state.current=Object.keys(state.profiles)[0];render();}catch(err){alert(err.message);}finally{e.target.value='';}};
$('mobFile').onchange=async e=>{const file=e.target.files?.[0];if(!file)return;try{alert(importMobs(await file.text())+' '+t('records'));render();}catch(err){alert(err.message);}finally{e.target.value='';}};
render();
</script></body></html>
